# ============================== NyayaMitra configuration ==============================
# Copy to .env and fill at least two API keys (free tiers are enough).

# ---- Hard limits (enforced in Python) ----
MAX_RETRIEVAL_CALLS=2          # retrieval tool calls per consultation
MAX_GROUNDING_RETRIES=1        # bounded correction after the auditor rejects a draft
MAX_CLARIFICATION_RETRIES=1    # times an unanswered question is repeated before marking it UNRESOLVED
MAX_TOTAL_CLARIFICATIONS=4     # max questions asked per consultation

# ---- API keys ----
GROQ_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=                # also used for voice input (speech-to-text)
OPENAI_API_KEY=

# ---- Default model names per provider ----
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.5-flash-lite
SARVAM_MODEL=sarvam-105b
OPENAI_MODEL=gpt-4o-mini

# ---- Model per role: "provider:model" (swap any role with one line) ----
# LLM1_MODEL=groq:qwen/qwen3.8-27b            # intake, language, classifier, validator
# LLM2_MODEL=gemini:gemini-3.5-flash-lite     # facts, queries, drafting
# LLM3_MODEL=groq:qwen/qwen3.8-27b            # independent auditor (keep a different provider from LLM2)
# TRANSLATE_MODEL=gemini:gemini-3.5-flash-lite
# FALLBACK_MODELS=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,sarvam:sarvam-105b

# DATABASE_PATH=nyayamitra.db
